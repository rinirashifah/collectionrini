# Server Port
PORT=8080
GIN_MODE=debug

# API Security (Access token for Rini's app)
API_KEY=rini-secret-2024

# Database PostgreSQL (e.g. Neon connection string)
# If left empty, backend falls back to local SQLite database (collection_rini.db)
DATABASE_URL=postgres://username:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=koleksi_rini
